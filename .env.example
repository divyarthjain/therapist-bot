# ── Serenity — Environment Configuration ─────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# All variables have sensible defaults and are optional.

# ── SenseVoice (Audio Analysis) ──────────────────────────────────────────────

# Device for SenseVoice inference.
# Options: "cpu", "mps" (Apple Silicon), "cuda" (NVIDIA GPU)
# Default: "mps" if available, else "cpu"
SENSEVOICE_DEVICE=cpu

# ── Gemini (LLM) ─────────────────────────────────────────────────────────────

# Required for therapeutic chat.
GEMINI_API_KEY=your_gemini_api_key_here

# Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional override for proxies / compatible gateways
# Default: https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ── Deepgram (Realtime STT / TTS) ────────────────────────────────────────────

# Required for live transcription and spoken replies.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Default: nova-3
# DEEPGRAM_STT_MODEL=nova-3

# Default: aura-2-thalia-en
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
